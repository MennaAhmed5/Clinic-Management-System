@model PaginatedList<Appointment>

<div class="w-100 card border-0 p-4">
    <div class="card-header bg-success bg-gradient m-lg-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Appointments List</h2>
            </div>
        </div>
    </div>
</div>
<div class="card-body border p-4">
    <div class="row pb-3">
        <div class="col-6 offset-6 text-end">
            <a asp-controller="Appointment" asp-action="Create" class="btn btn-secondary">
                <i class="bi bi-plus-circle"></i>  Create New Appointment
            </a>
        </div>
    </div>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Appointment Date</th>
                <th>Appointment Time</th>
                <th>Patient Name</th>
                <th>Doctor Name</th>               
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model.Items)
            {
                <tr>
                    <td>@obj.AppointmentDate</td>
                    <td>@obj.AppointmentTime</td>
                    <td>@obj.Patient.Name</td>
                    <td>@obj.Doctor.Name</td>                    
                     
                    <td>
                        <div class="w-50 btn-group" role="group">
                            <a data-bs-toggle="modal" data-bs-target="#deleteAppointmentModal">
                                <i class="btn btn-danger mx-2">
                                    <i class="bi bi-trash-fill"></i> Delete
                                </i>
                            </a>
                        </div>
                    </td>
                </tr>

                <partial name="~/Views/Appointment/Partials/_DeleteAppointmentModal.cshtml" model="@obj.Id" />

            }
        </tbody>
    </table>
    <div class="row">
        <div class="col-md-6">
        </div>
        <div class="col-md-6">
            <nav>
                <ul class="pagination justify-content-end">
                    <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                        <a class="page-link text-white" asp-route-pageNumber="1">
                            <span>First</span>
                        </a>
                    </li>
                    <li class="page-item @(Model.HasPreviusPage == false ? "disabled" : "")">
                        <a class="page-link text-white" asp-route-pageNumber="@(Model.PageIndex - 1)">
                            <span>Previous</span>
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                            <a class="page-link text-white" asp-route-pageNumber="@i">@i</a>
                        </li>
                    }

                    <li class="page-item  @(Model.HasNextPage == false ? "disabled" : "")">
                        <a class="page-link text-white" asp-route-pageNumber="@(Model.PageIndex + 1)">
                            <span>Next</span>
                        </a>
                    </li>
                    <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link text-white" asp-route-pageNumber="@(Model.TotalPages + 1)">
                            <span>Last</span>
                        </a>
                    </li>

                </ul>
            </nav>
        </div>
    </div>
</div>

 
     

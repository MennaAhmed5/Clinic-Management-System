 @model CreateAppointmentVM

<div class="w-100 card border-0 p-4">
    <div class="card-header bg-success bg-gradient m-lg-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Create Appointment</h2>
            </div>
        </div>
    </div>
</div>

<div class="w-100 card-border border p-4">

    <form method="post" class="row" enctype="multipart/form-data">
       <!-- Patient Information -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-light py-3">
                    <h5 class="text-success mb-0">
                        <i class="bi bi-person-vcard me-2"></i>
                        Patient Information
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="Patient.Name"
                                   class="form-label"></label>
                            <input asp-for="Patient.Name"
                                   class="form-control"
                                   placeholder="Enter full name" />
                            <span asp-validation-for="Patient.Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Patient.Phone"
                                   class="form-label"></label>
                            <input asp-for="Patient.Phone"
                                   class="form-control"
                                   placeholder="Enter phone number" />
                            <span asp-validation-for="Patient.Phone"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Patient.DateOfBirth"
                                   class="form-label"></label>
                            <input asp-for="Patient.DateOfBirth"
                                   type="date"
                                   class="form-control" />
                            <span asp-validation-for="Patient.DateOfBirth"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Patient.Gender"
                                   class="form-label"></label>
                            <select asp-for="Patient.Gender" class="form-select">                      
                                <option value="">Select Gender</option>
                                @foreach (Gender gender in Enum.GetValues(typeof(Gender)))
                                {                
                                        <option value="@gender">@gender</option>
                                }
                            </select>
                        <span asp-validation-for="Patient.Gender"
                              class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Patient.Email"
                                   class="form-label"></label>
                            <input asp-for="Patient.Email"
                                   class="form-control"
                                   placeholder="Enter Patiant Email" />
                            <span asp-validation-for="Patient.Email"
                                  class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Patient.Address"
                                   class="form-label"></label>
                            <input asp-for="Patient.Address"
                                      class="form-control"
                                      placeholder="Enter patient address">
                        <span asp-validation-for="Patient.Address"
                              class="text-danger"></span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Appointment Information -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-light py-3">
                    <h5 class="text-success mb-0">
                        <i class="bi bi-calendar-check me-2"></i>
                        Appointment Information
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="Appointment.DoctorId"
                                   class="form-label"></label>
                            <select asp-for="Appointment.DoctorId" asp-items="@Model.DoctorsList" id="doctorsDropdown"                                
                                    class="form-select">
                                <option value="">Select Doctor</option>
                            </select>
                            <span asp-validation-for="Appointment.DoctorId"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="@Model.Appointment.AppointmentDate"
                                   class="form-label"></label>
                            <input asp-for="Appointment.AppointmentDate"                                   
                                   id="appointmentDate" class="form-control" />
                            <span asp-validation-for="Appointment.AppointmentDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Appointment.AppointmentTime"
                                   class="form-label"></label>
                            <select asp-for="Appointment.AppointmentTime" id="timeSlots"
                                    class="form-select">
                                <option value="">Select Available Time</option>
                            </select>
                            <span asp-validation-for="Appointment.AppointmentTime"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Visit Duration</label>
                            <input class="form-control"
                                   value="30 Minutes"
                                   readonly />
                        </div>

                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="row pt-2">
                <div class="col-6 col-md-3">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary w-100">
                        <i class="bi bi-x-circle me-1"></i>
                        Cancel
                    </a>
                </div>

                <div class="col-6 col-md-3 offset-md-6">
                    <button type="submit"
                            class="btn btn-success w-100">
                        <i class="bi bi-check-circle me-1"></i>
                        Save Appointment
                    </button>
                </div>
            </div>
   </form>
</div>

    @section Scripts{
        @{
            <partial name="_validationScriptsPartial"/> 
        }
        <script src="~/js/Appointment.js" asp-append-version="true"></script>
    }
@model DoctorVM

<div class="w-100 card border-0 p-4">
    <div class="card-header bg-success bg-gradient m-lg-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Create Doctor</h2>
            </div>
        </div>
    </div>
</div>

<div class="w-100 card-border border p-4">

    <form method="post" class="row">
       
        <div class="p-3">
            <div class="form-floating py-2 col-12">
                <input asp-for="@Model.Doctor.Name" class="form-control border shadow" />
                <label asp-for="@Model.Doctor.Name" class="m-2"></label>
                <span asp-validation-for="@Model.Doctor.Name" class="text-danger"></span>
            
            </div>
        </div>
        <div class="p-3">
            <div class="form-floating py-2 col-12">
                <input asp-for="@Model.Doctor.Phone" class="form-control border shadow" />
                <label asp-for="@Model.Doctor.Phone" class="m-2"></label>
                <span asp-validation-for="@Model.Doctor.Phone" class="text-danger"></span>

            </div>
        </div>

           <div class="p-3">
            <div class="form-floating py-2 col-12">
                <input asp-for="@Model.Doctor.Specialization" class="form-control border shadow" />
                <label asp-for="@Model.Doctor.Specialization" class="m-2"></label>
                <span asp-validation-for="@Model.Doctor.Specialization" class="text-danger"></span>

            </div>
        </div>
         
         <div class="p-3">
            @* <div asp-validation-summary="All"></div> *@
            <div class="form-floating py-2 col-12">
                <select asp-for="@Model.Doctor.ClinicId" 
                    asp-items="@Model.ClinicList" class=" form-select border shadow"> 
                  

                        <option selected value="">-- select Clinic --</option>

                 </select>
                        
                <label asp-for="@Model.Doctor.ClinicId" class="ms-2"></label>

                <span asp-validation-for="@Model.Doctor.ClinicId" class="text-danger"></span>
            </div>
        </div>
        <div class="row pt-2">
            <div class="col-6 col-md-3">
                <button type="submit" class="btn btn-success w-100">
                    <i class="bi bi-check-circle"></i> Create
                </button>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Doctor" asp-action="Index" class="btn btn-secondary w-100">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>


        </div>
    </form>
</div>
 @model IEnumerable<Clinic>

<div class="w-100 card border-0 p-4">
    <div class="card-header bg-success bg-gradient m-lg-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Clinic List</h2>
            </div>
        </div>
    </div>
</div>
<div class="card-body border p-4">
    <div class="row pb-3">
        <div class="col-6 offset-6 text-end">
            <a asp-controller="Clinic" asp-action="Create" class="btn btn-secondary">
                <i class="bi bi-plus-circle"></i>  Create New Clinic
            </a>
        </div>
    </div>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th> Name</th>
                <th> Phone</th>
                <th> Address</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model)
            {
                <tr>
                    <td>@obj.Name</td>
                    <td>@obj.Phone</td>
                    <td>@obj.Address</td>
                    <td>
                        <div class="w-75 btn-group" role="group">
                            <a asp-action="Update" asp-controller="Clinic" asp-route-clinicId="@obj.Id">
                                <i class="btn btn-success mx-2">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </i>
                            </a>

                            <a asp-action="Delete" asp-controller="Clinic" asp-route-clinicId="@obj.Id">
                                <i class="btn btn-danger mx-2">
                                    <i class="bi bi-trash-fill"></i> Delete
                                </i>
                            </a>                        
                        </div>
                    </td>
                </tr>
            }      
        </tbody>
    </table>
</div>
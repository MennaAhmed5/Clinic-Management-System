@model Clinic   

<div class="w-100 card border-0 p-4">
    <div class="card-header bg-success bg-gradient m-lg-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Delete Villa</h2>
            </div>
        </div>
    </div>
</div>

<div class="w-100 card-border border p-4">

    <form method="post" class="row">
        <input asp-for="Id" hidden />
        
        <div class="col-12">
            <div class="p-3">
                
                <div class="form-floating py-2 col-12">
                    <input disabled asp-for="Name" class="form-control border shadow" />
                    <label asp-for="Name" class="m-2"></label>
                </div>

                <div class="form-floating py-2 col-12">
                    <input disabled asp-for="Phone" class="form-control border shadow" />
                    <label asp-for="Phone" class="m-2"></label>

 
                </div>

                <div class="form-floating py-2 col-12">
                    <input disabled asp-for="Address" class="form-control border shadow" />
                    <label asp-for="Address" class="m-2"></label>
                </div>              
                <div class="row pt-2">
                    <div class="col-6 col-md-3">
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Clinic" asp-action="Index" class="btn btn-secondary w-100">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </div>
            </div>
        </div>
               
    </form>
</div>

@section Scripts{
    @{
        <partial name="_validationScriptsPartial" />
    }
}